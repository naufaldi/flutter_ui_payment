# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Example build output and screenshot runs (regenerable; large)
example/build/

# Third-party reference captures used only for design research.
# Not licensed for redistribution: never publish them.
docs/design-research/refs/*.png

# Docs website
website/node_modules/
website/dist/
website/.astro/
website/.netlify/

# Retain git exclusions: pubignore overrides gitignore in this directory.
# Site media and contributor/research records are not library assets.
/website/
/docs/
/AGENTS.md
/CLAUDE.md
/PRD.md
/skills-lock.json
