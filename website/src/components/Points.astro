---
// Homepage only: a ruled two-column list of short points (benefits, proof,
// FAQ). No boxes; each point sits under one hairline. `faq` puts the question
// beside its answer on wide screens.
interface Props {
  variant?: 'grid' | 'faq';
}
const { variant = 'grid' } = Astro.props;
---

<div class:list={['fup-points', `fup-points-${variant}`]}><slot /></div>

<style>
  .fup-points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin-top: 1.5rem;
  }
  .fup-points-faq {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (max-width: 45rem) {
    .fup-points {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
