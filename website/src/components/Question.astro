---
// One FAQ entry inside <Points variant="faq"> (D111): a native <details>
// disclosure, so it opens by click, Enter or Space without JavaScript. The
// question is a real heading inside the summary, which keeps it in the page
// outline. The answer fades in over 180 ms
// when it opens (D118) and the mark turns; it closes instantly and never
// animates height.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="fup-question">
  <summary>
    <h3>{title}</h3>
    <span class="fup-question-mark" aria-hidden="true"></span>
  </summary>
  <div class="fup-question-body"><slot /></div>
</details>

<style>
  /* Starlight styles content <details> with a left border, a chevron and an
     open-state margin. This one is a hairline row instead, so those go. */
  .fup-question {
    border-top: 1px solid var(--fup-rule);
    border-inline-start: 0;
    padding-inline-start: 0;
  }
  .fup-question > summary::before {
    content: none;
    display: none;
  }
  .fup-question[open] > summary {
    margin-bottom: 0;
  }
  .fup-question:last-child {
    border-bottom: 1px solid var(--fup-rule);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3rem;
    padding-block: 0.75rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: 2px;
  }
  h3 {
    margin: 0;
    font-size: var(--sl-text-base);
    font-weight: 600;
    line-height: 1.4;
    color: var(--fup-ink);
    text-wrap: balance;
  }
  /* A plus that becomes a minus: two 1.5 px ink strokes. The vertical stroke
     turns flat as it goes (transform only), then hides. */
  .fup-question-mark {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }
  .fup-question-mark::before,
  .fup-question-mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--fup-ink);
  }
  .fup-question-mark::after {
    transform: rotate(90deg);
    transition: transform 200ms var(--fup-ease-out);
  }
  .fup-question[open] .fup-question-mark::after {
    transform: rotate(0deg);
  }
  summary {
    transition: transform var(--fup-dur-press) var(--fup-ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    summary:active {
      transform: scale(0.97);
    }
    :global(:root[data-fup-motion]) .fup-question[open] .fup-question-body {
      animation: fup-answer-in var(--fup-dur-ui) var(--fup-ease-out) both;
    }
  }
  @keyframes fup-answer-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .fup-question-body {
    padding-bottom: 1.25rem;
    max-width: 65ch;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  .fup-question-body > :global(*) {
    margin: 0;
  }
  .fup-question-body > :global(* + *) {
    margin-top: 0.5rem;
  }
</style>
