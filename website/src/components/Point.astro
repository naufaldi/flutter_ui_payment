---
// One item in <Points>. The title is a real heading so the page outline and
// screen-reader heading navigation include it; the body is the slotted MDX.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="fup-point">
  <h3>{title}</h3>
  <div class="fup-point-body"><slot /></div>
</div>

<style>
  .fup-point {
    margin: 0;
    padding-block: 1.25rem;
    border-top: 1px solid var(--fup-rule);
  }
  h3 {
    margin: 0;
    font-size: var(--sl-text-base);
    font-weight: 600;
    line-height: 1.4;
    color: var(--fup-ink);
    text-wrap: balance;
  }
  .fup-point-body {
    margin-top: 0.375rem;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
    max-width: 65ch;
  }
  .fup-point-body > :global(*) {
    margin: 0;
  }
  .fup-point-body > :global(* + *) {
    margin-top: 0.5rem;
  }
  /* Phones: a tighter rhythm, since the points stack in one column (D116). */
  @media (max-width: 45rem) {
    .fup-point {
      padding-block: 1rem;
    }
    .fup-point-body {
      margin-top: 0.25rem;
      line-height: 1.55;
    }
  }
</style>
