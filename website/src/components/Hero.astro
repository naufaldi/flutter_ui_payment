---
// Replaces Starlight's centered hero on the landing page: a left-aligned
// promise, one primary and one secondary action, the install command, a
// subordinate source/package line, and the payment-state switcher (D111): one
// large real capture for success, pending, unknown or a changed total.
// Button styles (.fup-btn) live in hairline.css, shared with Cta.astro.
import StateSwitcher from './StateSwitcher.astro';

const { data } = Astro.locals.starlightRoute.entry;
const hero = data.hero!;
const [primary, ...secondary] = hero.actions;
---

<div class="fup-hero">
  <div class="fup-hero-copy">
    <p class="fup-eyebrow">Flutter package Â· rakit_ui 0.1.0 Â· MIT</p>
    <h1 id="_top" data-page-title set:html={hero.title} />
    {hero.tagline && <p class="fup-lede" set:html={hero.tagline} />}
    <div class="fup-actions">
      {primary && <a class="fup-btn fup-btn-primary" href={primary.link}>{primary.text}</a>}
      {secondary.map((a) => <a class="fup-btn fup-btn-secondary" href={a.link}>{a.text}</a>)}
    </div>
    <p class="fup-install" data-fup-copy>
      <span class="fup-install-label">Install</span>
      <code>flutter pub add rakit_ui</code>
      {/* Hidden until the script runs; without JS the command stays selectable. */}
      <button type="button" class="fup-copy" aria-label="Copy install command" hidden>
        <svg class="fup-copy-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="11" height="11" rx="2" />
          <path d="M5 15V6a2 2 0 0 1 2-2h9" />
        </svg>
        <svg class="fup-done-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </button>
      <span class="sr-only" aria-live="polite" data-fup-copy-status></span>
    </p>
    <p class="fup-source">
      <a href="https://github.com/naufaldi/flutter_ui_payment">Source on GitHub</a>
      <span aria-hidden="true">Â·</span>
      <a href="https://pub.dev/packages/rakit_ui">rakit_ui on pub.dev</a>
    </p>
  </div>
  <StateSwitcher />
</div>

<style>
  .fup-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
    padding-block: 2.5rem 1.5rem;
  }
  .fup-eyebrow {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--fup-muted);
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fup-ink);
    text-wrap: balance;
    /* At 200% text on a 320px screen a long word can exceed the column. */
    hyphens: auto;
    margin: 0;
  }
  h1 :global(span) {
    color: var(--fup-muted);
  }
  .fup-lede {
    margin: 1.25rem 0 0;
    max-width: 36rem;
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .fup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .fup-install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0.625rem 0.875rem;
    max-width: 26rem;
    border: 1px solid var(--fup-rule);
    border-radius: var(--fup-radius-control);
    background: var(--fup-surface-muted);
  }
  .fup-install-label {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fup-muted);
  }
  .fup-install code {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--fup-ink);
    background: none;
    padding: 0;
    user-select: all;
    overflow-wrap: anywhere;
  }
  .fup-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: -0.5rem -0.625rem -0.5rem auto;
    padding: 0;
    border: 0;
    border-radius: var(--fup-radius-control);
    background: none;
    color: var(--fup-muted);
    cursor: pointer;
    transition:
      color 150ms ease,
      transform var(--fup-dur-press) var(--fup-ease-out);
  }
  .fup-copy[hidden] {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .fup-copy:hover {
      color: var(--fup-ink);
    }
  }
  .fup-copy .fup-done-icon,
  .fup-copy[data-copied] .fup-copy-icon {
    display: none;
  }
  .fup-copy[data-copied] {
    color: var(--fup-ink);
  }
  .fup-copy[data-copied] .fup-done-icon {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fup-copy:active {
      transform: scale(0.94);
    }
    .fup-source a:active {
      transform: scale(0.97);
    }
    /* The check pops in when the copy succeeds (D118). */
    :global(:root[data-fup-motion]) .fup-copy[data-copied] .fup-done-icon {
      animation: fup-pop var(--fup-dur-ui) var(--fup-ease-out) both;
    }
  }
  @keyframes fup-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .fup-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0.875rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--fup-muted);
  }
  .fup-source a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fup-muted);
    text-decoration: underline;
    text-decoration-color: var(--fup-rule);
    text-underline-offset: 0.2em;
    transition:
      color 150ms ease,
      transform var(--fup-dur-press) var(--fup-ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .fup-source a:hover {
      color: var(--fup-ink);
      text-decoration-color: currentColor;
    }
  }
  .fup-source span {
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 50rem) {
    .fup-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 1.5rem;
    }
  }
  /* Narrow phones: stack the two actions full width so each reads as a button. */
  @media (max-width: 30rem) {
    h1 {
      font-size: clamp(1.5rem, 10vw, 2rem);
    }
    .fup-actions {
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fup-source a,
    .fup-copy {
      transition: none;
    }
  }
</style>

<script>
  // Install copy button (D110): copies the command, shows a check for 1.5 s
  // and announces the result. Without the Clipboard API it selects the
  // command so the reader can copy it with the keyboard.
  for (const box of document.querySelectorAll<HTMLElement>('[data-fup-copy]')) {
    const button = box.querySelector<HTMLButtonElement>('button');
    const code = box.querySelector('code');
    const status = box.querySelector<HTMLElement>('[data-fup-copy-status]');
    if (!button || !code || !status) continue;
    button.hidden = false;
    let timer: number | undefined;
    const announce = (text: string) => {
      status.textContent = text;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        status.textContent = '';
        delete button.dataset.copied;
      }, 1500);
    };
    const select = () => {
      const range = document.createRange();
      range.selectNodeContents(code);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      announce('Command selected. Press Ctrl+C or Command+C to copy.');
    };
    button.addEventListener('click', async () => {
      const text = code.textContent?.trim() ?? '';
      if (!navigator.clipboard?.writeText) return select();
      try {
        await navigator.clipboard.writeText(text);
        button.dataset.copied = '';
        announce('Copied');
      } catch {
        select();
      }
    });
  }
</script>
