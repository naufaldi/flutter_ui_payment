---
// Replaces Starlight's centered hero on the landing page: a left-aligned
// promise, two actions, and two real native captures (the unknown outcome
// and the checkout it came from). Dark captures swap in under the dark theme.
import screens from '../data/screens.json';

const { data } = Astro.locals.starlightRoute.entry;
const hero = data.hero!;
const all = screens as Record<string, { width: number; height: number }>;
const shot = (name: string) => ({ src: `/screens/${name}.webp`, ...all[name] });
const pairs = [
  {
    light: shot('ios_refined_status_unknown_light'),
    dark: shot('ios_refined_status_unknown_dark'),
    alt: 'Payment screen with a hatched amber band, the title "Result not confirmed yet", the amount Rp102,500, the line "Don\'t pay again." and one action, Check status.',
    darkAlt: 'The same unknown-outcome screen in dark mode, in Indonesian: hatched amber band, "Hasil belum terkonfirmasi", Rp102.500, "Jangan bayar lagi." and one action, Cek status.',
    caption: 'Submit timed out after the server accepted it',
  },
  {
    light: shot('ios_refined_checkout_light'),
    dark: shot('ios_refined_checkout_dark'),
    alt: 'Checkout screen with the order summary led by the total Rp102,500, a service fee line, a bordered payment-method list and a pinned bar with the total and a Review payment button.',
    darkAlt: 'The same checkout in dark mode, in Indonesian: order summary led by Rp102.500, payment-method list and a pinned bar with Tinjau pembayaran.',
    caption: 'The checkout it came from',
  },
];
---

<div class="fup-hero">
  <div class="fup-hero-copy">
    <p class="fup-eyebrow">flutter_ui_payment · 0.1.0, not yet published</p>
    <h1 id="_top" data-page-title set:html={hero.title} />
    {hero.tagline && <p class="fup-lede" set:html={hero.tagline} />}
    <div class="fup-actions">
      {
        hero.actions.map((a, i) => (
          <a class:list={['fup-btn', i === 0 ? 'fup-btn-primary' : 'fup-btn-secondary']} href={a.link}>
            {a.text}
          </a>
        ))
      }
    </div>
  </div>
  <div class="fup-hero-shots">
    {
      pairs.map((p, i) => (
        <figure class:list={['fup-hero-shot', i === 1 && 'fup-hero-shot-back']}>
          <img
            class="fup-only-light"
            src={p.light.src}
            width={p.light.width}
            height={p.light.height}
            alt={p.alt}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
          <img
            class="fup-only-dark"
            src={p.dark.src}
            width={p.dark.width}
            height={p.dark.height}
            alt={p.darkAlt}
            loading="eager"
          />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .fup-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: 2.5rem 1rem;
  }
  .fup-eyebrow {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--fup-muted);
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--fup-ink);
    text-wrap: balance;
    margin: 0;
  }
  h1 :global(span) {
    color: var(--fup-muted);
  }
  .fup-lede {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .fup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .fup-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: var(--fup-radius-control);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .fup-btn-primary {
    background: var(--fup-ink);
    color: var(--fup-surface);
  }
  .fup-btn-primary:hover {
    background: color-mix(in srgb, var(--fup-ink) 88%, var(--fup-surface));
  }
  .fup-btn-secondary {
    border: 1px solid var(--fup-border);
    color: var(--fup-ink);
  }
  .fup-btn-secondary:hover {
    background: var(--fup-surface-muted);
  }
  .fup-hero-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }
  .fup-hero-shot {
    margin: 0;
  }
  .fup-hero-shot-back {
    margin-top: 3rem;
  }
  .fup-hero-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--fup-rule);
    border-radius: var(--fup-radius-box);
    background: var(--fup-surface-muted);
  }
  .fup-hero-shot figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    color: var(--fup-muted);
  }
  @media (max-width: 50rem) {
    .fup-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 1.5rem;
    }
    .fup-hero-shot-back {
      margin-top: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fup-btn {
      transition: none;
    }
  }
</style>
