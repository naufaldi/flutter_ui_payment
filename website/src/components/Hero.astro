---
// Replaces Starlight's centered hero on the landing page: a left-aligned
// promise, one primary and one secondary action, the install command, a
// subordinate source/package line, and two real native captures (the unknown
// outcome and the checkout it came from). Dark captures swap in under the dark
// theme; they are lazy so a hidden (display: none) pair is not fetched in the
// light theme. Button styles (.fup-btn) live in hairline.css, shared with Cta.astro.
import screens from '../data/screens.json';

const { data } = Astro.locals.starlightRoute.entry;
const hero = data.hero!;
const all = screens as Record<string, { width: number; height: number }>;
const shot = (name: string) => ({ src: `/screens/${name}.webp`, ...all[name] });
const pairs = [
  {
    light: shot('android_refined_status_unknown_light'),
    dark: shot('android_refined_status_unknown_dark'),
    alt: 'Payment screen with a hatched amber band, the title "Result not confirmed yet", the amount Rp102,500, the line "Don\'t pay again." and one action, Check status.',
    darkAlt: 'The same unknown-outcome screen in dark mode, in Indonesian: hatched amber band, "Hasil belum terkonfirmasi", Rp102.500, "Jangan bayar lagi." and one action, Cek status.',
    caption: 'Submit timed out after the server accepted it',
  },
  {
    light: shot('android_refined_checkout_light'),
    dark: shot('android_refined_checkout_dark'),
    alt: 'Checkout screen with the order summary led by the total Rp102,500, a service fee line, a bordered payment-method list and a pinned Review payment button.',
    darkAlt: 'The same checkout in dark mode, in Indonesian: order summary led by Rp102.500, payment-method list and a pinned bar with Tinjau pembayaran.',
    caption: 'The checkout it came from',
  },
];
const [primary, ...secondary] = hero.actions;
---

<div class="fup-hero">
  <div class="fup-hero-copy">
    <p class="fup-eyebrow">Flutter package · rakit_ui 0.1.0 · MIT</p>
    <h1 id="_top" data-page-title set:html={hero.title} />
    {hero.tagline && <p class="fup-lede" set:html={hero.tagline} />}
    <div class="fup-actions">
      {primary && <a class="fup-btn fup-btn-primary" href={primary.link}>{primary.text}</a>}
      {secondary.map((a) => <a class="fup-btn fup-btn-secondary" href={a.link}>{a.text}</a>)}
    </div>
    <p class="fup-install">
      <span class="fup-install-label">Install</span>
      <code>flutter pub add rakit_ui</code>
    </p>
    <p class="fup-source">
      <a href="https://github.com/naufaldi/flutter_ui_payment">Source on GitHub</a>
      <span aria-hidden="true">·</span>
      <a href="https://pub.dev/packages/rakit_ui">rakit_ui on pub.dev</a>
    </p>
  </div>
  <div class="fup-hero-shots">
    {
      pairs.map((p, i) => (
        <figure class:list={['fup-hero-shot', i === 1 && 'fup-hero-shot-back']}>
          <img
            class="fup-only-light"
            src={p.light.src}
            width={p.light.width}
            height={p.light.height}
            alt={p.alt}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
          <img
            class="fup-only-dark"
            src={p.dark.src}
            width={p.dark.width}
            height={p.dark.height}
            alt={p.darkAlt}
            loading="lazy"
          />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .fup-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
    padding-block: 2.5rem 1.5rem;
  }
  .fup-eyebrow {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--fup-muted);
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fup-ink);
    text-wrap: balance;
    /* At 200% text on a 320px screen a long word can exceed the column. */
    hyphens: auto;
    margin: 0;
  }
  h1 :global(span) {
    color: var(--fup-muted);
  }
  .fup-lede {
    margin: 1.25rem 0 0;
    max-width: 36rem;
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .fup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .fup-install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0.625rem 0.875rem;
    max-width: 26rem;
    border: 1px solid var(--fup-rule);
    border-radius: var(--fup-radius-control);
    background: var(--fup-surface-muted);
  }
  .fup-install-label {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fup-muted);
  }
  .fup-install code {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--fup-ink);
    background: none;
    padding: 0;
    user-select: all;
    overflow-wrap: anywhere;
  }
  .fup-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0.875rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--fup-muted);
  }
  .fup-source a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fup-muted);
    text-decoration: underline;
    text-decoration-color: var(--fup-rule);
    text-underline-offset: 0.2em;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .fup-source a:hover {
      color: var(--fup-ink);
      text-decoration-color: currentColor;
    }
  }
  .fup-source span {
    display: inline-flex;
    align-items: center;
  }
  .fup-hero-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }
  .fup-hero-shot {
    margin: 0;
  }
  .fup-hero-shot-back {
    margin-top: 3rem;
  }
  .fup-hero-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--fup-rule);
    border-radius: var(--fup-radius-box);
    background: var(--fup-surface-muted);
  }
  .fup-hero-shot figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    color: var(--fup-muted);
  }
  @media (max-width: 50rem) {
    .fup-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 1.5rem;
    }
    .fup-hero-shot-back {
      margin-top: 2rem;
    }
  }
  /* Narrow phones: stack the two actions full width so each reads as a button. */
  @media (max-width: 30rem) {
    .fup-actions {
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fup-source a {
      transition: none;
    }
  }
</style>
