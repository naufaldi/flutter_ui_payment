---
// Homepage only (D110): how to reach the maintainer. Two ruled rows, no form.
import { REPO_URL } from '../consts';

const email = 'naufaldi.rafif@gmail.com';
---

<section class="fup-contact not-content" aria-labelledby="fup-contact-title">
  <h2 id="fup-contact-title">Questions or stuck setting up?</h2>
  <p>Write to the maintainer, or open an issue so the answer helps the next team too.</p>
  <ul>
    <li>
      <span class="fup-contact-label">Email</span>
      <a href={`mailto:${email}`}>{email}</a>
    </li>
    <li>
      <span class="fup-contact-label">GitHub Issues</span>
      <a href={`${REPO_URL}/issues/new`}>Ask or report on GitHub</a>
    </li>
  </ul>
</section>

<style>
  .fup-contact {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--fup-rule);
  }
  h2 {
    margin: 0;
    font-size: var(--sl-text-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fup-ink);
    text-wrap: balance;
  }
  p {
    margin: 0.5rem 0 0;
    max-width: 40rem;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    max-width: 40rem;
    border-top: 1px solid var(--fup-rule);
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    border-bottom: 1px solid var(--fup-rule);
  }
  .fup-contact-label {
    flex: 0 0 8rem;
    font-size: var(--sl-text-sm);
    color: var(--fup-muted);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fup-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--fup-border);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  @media (hover: hover) and (pointer: fine) {
    a:hover {
      text-decoration-color: currentColor;
    }
  }
  @media (max-width: 30rem) {
    li {
      padding-top: 0.5rem;
    }
    .fup-contact-label {
      flex-basis: 100%;
    }
  }
</style>
