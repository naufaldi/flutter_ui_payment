---
// Homepage only: the checkout recovery demo as three numbered steps, each a
// real Android capture from the registry (light and dark pairs, lazy-loaded).
// Wide screens show the steps side by side. Phones get a native sideways
// strip with scroll snap and a peek of the next step (D116): no JavaScript,
// and the region is focusable so arrow keys scroll it. D120: the markup keeps
// tabindex as the no-JavaScript fallback; the script below drops it while the
// steps fit side by side, so desktop Tab does not stop on a region with
// nothing to scroll.
import Screen from './Screen.astro';

const steps = [
  {
    title: 'Pay once',
    text: 'The customer reviews the item, the visible service fee and the method, then pays. The host starts one payment attempt.',
    name: 'android_block_checkout_review',
    dark: 'android_block_checkout_review_dark',
    alt: 'Checkout review in Indonesian: merchant, item Rp100.000, service fee Rp2.500, wallet method and a pinned pay button.',
  },
  {
    title: 'The response is lost',
    text: 'No receipt and no pay-again button. The screen says “Don’t pay again” and offers one action: check status of the same attempt.',
    name: 'android_block_checkout_unknown',
    dark: 'android_block_checkout_unknown_dark',
    alt: 'Unknown result in Indonesian: hatched amber band, "Hasil belum terkonfirmasi", Rp102.500, "Jangan bayar lagi.", reference DEMO-1 and one Cek status button.',
  },
  {
    title: 'Confirmed, then the receipt',
    text: 'The host confirms that same attempt. Only then does the matching receipt appear, with the same reference and total.',
    name: 'android_block_checkout_receipt',
    dark: 'android_block_checkout_receipt_dark',
    alt: 'Receipt in Indonesian after host-confirmed success, with the matching reference, total, service fee and masked wallet method.',
  },
];
---

<div class="fup-flow-scroll not-content" role="region" aria-label="Checkout recovery demo, three steps" tabindex="0">
  <ol class="fup-flow" data-fup-reveal="stagger">
    {
      steps.map((s, i) => (
        <li class="fup-flow-step">
          <p class="fup-flow-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3>{s.title}</h3>
          <p class="fup-flow-text">{s.text}</p>
          <Screen name={s.name} dark={s.dark} alt={s.alt} caption="" />
        </li>
      ))
    }
  </ol>
</div>

<script>
  // D120: focusable only while the strip actually overflows. The observer
  // re-checks on viewport, font-size and layout changes; no timers.
  for (const strip of document.querySelectorAll<HTMLElement>('.fup-flow-scroll')) {
    const update = () => {
      if (strip.scrollWidth > strip.clientWidth) strip.setAttribute('tabindex', '0');
      else strip.removeAttribute('tabindex');
    };
    update();
    const observer = new ResizeObserver(update);
    observer.observe(strip);
    if (strip.firstElementChild) observer.observe(strip.firstElementChild);
  }
</script>

<style>
  .fup-flow {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .fup-flow-step {
    margin: 0;
    padding-top: 1rem;
    border-top: 2px solid var(--fup-ink);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* The middle step is the point of the kit: mark it with the warning tone. */
  .fup-flow-step:nth-child(2) {
    border-top-color: var(--fup-warning);
  }
  .fup-flow-num {
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--fup-muted);
  }
  h3 {
    margin: 0;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fup-ink);
  }
  .fup-flow-text {
    margin: 0 0 0.75rem;
    max-width: 34ch;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .fup-flow-step :global(.fup-screen) {
    margin-top: auto;
    max-width: 20rem;
  }
  /* Phones: one sideways strip instead of three full-height captures. The
     strip runs to the screen edges; each step snaps to the content edge and
     the next one peeks in. */
  @media (max-width: 50rem) {
    .fup-flow-scroll {
      margin: 1.5rem calc(-1 * var(--sl-content-pad-x)) 0;
      padding: 0 var(--sl-content-pad-x) 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--sl-content-pad-x);
      scrollbar-width: thin;
    }
    .fup-flow-scroll:focus-visible {
      outline-offset: -2px;
    }
    .fup-flow {
      margin: 0;
      grid-template-columns: none;
      grid-auto-flow: column;
      /* vw, not %, so the list can be max-content wide and the strip keeps
         its end padding after the last step. */
      grid-auto-columns: min(14rem, 70vw);
      gap: 1rem;
      width: max-content;
    }
    .fup-flow-step {
      scroll-snap-align: start;
    }
    .fup-flow-text {
      margin-bottom: 0.5rem;
      font-size: var(--sl-text-sm);
      line-height: 1.5;
    }
    .fup-flow-step :global(.fup-screen) {
      max-width: none;
    }
  }
</style>
