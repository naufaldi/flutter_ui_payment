---
// Homepage only (D111): the same Merchant Overview block in two looks, the
// default Hairline and the Soft host preset, side by side on wide screens and
// stacked on phones. Real Android captures with their dark pairs.
import Screen from './Screen.astro';

const looks = [
  {
    title: 'Hairline',
    text: 'The default look: one surface, 1 px rules, ink actions.',
    name: 'android_block_merchant_overview',
    alt: 'Merchant Overview block in the default Hairline look: available balance, an unknown-payment notice and a revenue chart on one flat surface separated by thin rules.',
  },
  {
    title: 'Soft',
    text: 'A preset in the example app: tinted page, inset panel, rounder corners, indigo accent.',
    name: 'android_block_merchant_soft',
    alt: 'The same Merchant Overview block in the Soft host preset: a white inset panel with rounder corners on a tinted page, an indigo accent and a lighter balance.',
  },
];
---

<div class="fup-brand not-content">
  {
    looks.map((look) => (
      <div class="fup-brand-look">
        <h3>{look.title}</h3>
        <p>{look.text}</p>
        <Screen name={look.name} dark={`${look.name}_dark`} alt={look.alt} caption="" />
      </div>
    ))
  }
</div>

<style>
  .fup-brand {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 1.5rem;
  }
  /* Subgrid keeps both captures on one line when one description wraps. */
  .fup-brand-look {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-content: start;
    row-gap: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--fup-rule);
  }
  h3 {
    margin: 0;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fup-ink);
  }
  p {
    margin: 0.375rem 0 1rem;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }
  .fup-brand-look :global(.fup-screen) {
    max-width: 22.5rem;
  }
  @media (max-width: 45rem) {
    .fup-brand {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
